# Copia este archivo a .env (local) y define las mismas variables en Vercel
# (Project → Settings → Environment Variables). .env nunca se sube a GitHub.

# --- Acceso -----------------------------------------------------------------
# Genera ambos valores con: npm run hash -- "la-contraseña"
# En .env el hash va entre comillas simples porque contiene "$".
APP_PASSWORD_HASH='$2a$12$...'
SESSION_SECRET='...'

# --- Texto: Groq (https://console.groq.com/keys) ----------------------------
GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Imagen: Cloudflare Workers AI (proveedor por defecto) -------------------
# Account ID: panel de Cloudflare → Workers AI (o la URL del panel).
# Token: My Profile → API Tokens → Create Token → plantilla "Workers AI".
CF_ACCOUNT_ID=
CF_API_TOKEN=
# CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# --- Imagen alternativa: Hugging Face ----------------------------------------
# IMAGE_PROVIDER=huggingface
# HF_API_TOKEN=hf_...
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Tamaño para los modelos que lo admiten (Flux-1-schnell en Cloudflare siempre da 1024x1024)
# IMAGE_WIDTH=1024
# IMAGE_HEIGHT=576
